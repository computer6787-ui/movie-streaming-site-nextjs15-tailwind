# Copy to .env and fill in. .env is git-ignored; this template is not.
#
#   cp .env.example .env
#
# On Render, set the same variable in the dashboard instead (render.yaml
# declares it with sync: false, so the value is never committed either way).

# REQUIRED. TMDB v3 API key (not a read access token).
#   https://www.themoviedb.org/settings/api
# The app throws "NEXT_PUBLIC_TMDB_API_KEY is not set" on first request
# without this, so nothing renders until it is present. It is NEXT_PUBLIC_*
# because the key is read in client components, which means it is visible in
# the browser bundle -- that is fine for a TMDB v3 key, and is exactly why it
# must not be a secret. Rotate it if it ever leaves your control.
NEXT_PUBLIC_TMDB_API_KEY=

# Optional. Set to 1 to log each TMDB request path and response length to the
# server console. Handy when a page renders empty and you need to see whether
# the request failed or the response was just empty.
TMDB_DEBUG=
