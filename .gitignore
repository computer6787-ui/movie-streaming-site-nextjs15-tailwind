# --- Render deploy hygiene -----------------------------------------------
# Build output of the Electron main process: regenerated by
# `npm run build:electron` on a dev machine, never needed on Render.
lumen-browser/electron/*.cjs
lumen-browser/electron/*.cjs.map
# Local dev-server logs from running the desktop app.
lumen-browser/dev-server.log
lumen-browser/dev-server.err
lumen-browser/electron-startup.log
lumen-browser/*.log
