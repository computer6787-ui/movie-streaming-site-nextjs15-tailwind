{
  "manifest_version": 3,
  "name": "Chitralipi Ad Blocker",
  "version": "1.0.0",
  "description": "Blocks ads, popunders and click-bait on Chitralipi and the embedded player, using uBlock's EasyList.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chitralipi Ad Blocker"
  }
}
